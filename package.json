{
  "name": "@local/solids-world-harness",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An interactive 3D atlas of solid-state and atomic physics for DeepSeek Harness.",
  "keywords": ["deepseek-harness", "dsh-plugin", "solid-state-physics", "crystal", "3d", "atlas"],
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
